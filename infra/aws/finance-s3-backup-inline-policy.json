{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExistingFinanceBackupBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::screening40-staging-backups"
    },
    {
      "Sid": "PutEncryptedFinances2027BackupsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::screening40-staging-backups/finance/postgresql/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "VerifyExistingFinances2027BackupsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::screening40-staging-backups/finance/postgresql/*"
    }
  ]
}
